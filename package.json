{
  "author": "joabssilveira",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/crypto-js": "4.2.2",
    "@types/node": "22.13.4",
    "axios": "1.20.0",
    "crypto-js": "4.2.0",
    "husky": "9.1.7",
    "moment": "2.30.1",
    "standard-version": "9.5.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=10"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/joabssilveira/fwork-jsts-common",
  "keywords": [
    "javascript",
    "typescript",
    "utils"
  ],
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "name": "fwork-jsts-common",
  "peerDependencies": {
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "moment": "^2.30.1",
    "tslib": "^2.8.1"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "scripts": {
    "build": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "prepare": "husky",
    "pub": "npm run build && npm run release && git push --follow-tags origin main && npm publish",
    "release": "standard-version"
  },
  "types": "dist/types/index.d.ts",
  "version": "2.1.0"
}
